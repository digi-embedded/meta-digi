{
  "name": "flutter-demo",
  "friendly_name": "Flutter Demo",
  "version": "1.0",
  "runtime": "lxc",
  "registration_defaults": {
    "autostart": true,
    "monitor": true,
    "drm": {
      "enabled": true,
      "stats_sample_interval_s": 30,
      "stats_list_of_metrics": [
        "uptime",
        "cpu",
        "mem",
        "net/rx",
        "net/tx",
        "disk/read",
        "disk/write"
      ]
