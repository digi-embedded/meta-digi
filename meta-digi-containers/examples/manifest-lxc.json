    "restart": {
      "enabled": true,
      "max_retries": 3,
      "window": 60,
      "retry_delay": 3
    }
  },
  "device_types": ["ccmp25-dvk"],
  "firmware_versions": "",
  "build_id": "",
  "description": "",
  "labels": {}
}
